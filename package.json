{
  "name": "geolynq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@geolynq/admin",
    "build": "npm run build --workspace=@geolynq/admin",
    "lint": "npm run lint --workspace=@geolynq/admin",
    "dev:widget": "npm run dev --workspace=@geolynq/widget",
    "build:widget": "npm run build --workspace=@geolynq/widget",
    "test:widget": "npm run test --workspace=@geolynq/widget"
  }
}
