# Publicas (protegidas por RLS) — Project Settings > API no Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta — só em rotas server-side do Admin (import de planilha, criacao de tenant)
# Nunca no navegador, nunca no GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Sessao do Admin — gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
